{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "eRisk Eval (CLI)",
            "type": "debugpy",
            "request": "launch",
            "module": "app.cli",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--mode",
                "eval",
                "--personas",
                "10",
                "--seed",
                "42",
                "--eval_mode",
                "mixed_holdout",
                "--prompt_version",
                "v1",
                "--save_diagnostics",
                "true",
                "--max_api_calls",
                "380",
                "--trace_level",
                "compact",
                "--fit_calibrator",
                "auto"
            ]
        },
        {
            "name": "eRisk Interactive (CLI)",
            "type": "debugpy",
            "request": "launch",
            "module": "app.cli",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--mode",
                "interactive",
                "--personas",
                "10",
                "--seed",
                "42",
                "--interactive_persona_index",
                "0",
                "--max_api_calls",
                "180"
            ]
        }
    ]
}
