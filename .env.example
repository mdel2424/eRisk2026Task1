# AUTH
OPENROUTER_API_KEY=

# DETECTOR
DETECTOR_BACKEND=openrouter
OPENROUTER_DETECTOR_MODEL=openai/gpt-oss-120b
OPENROUTER_PROVIDER_ORDER=Groq,deepinfra/turbo,baseten/fp4
OPENROUTER_REQUIRE_PROVIDER_ORDER=1
OPENROUTER_REASONING_EFFORT=low
DETECTOR_MAX_NEW_TOKENS=512
DETECTOR_EXTRACTOR_MAX_NEW_TOKENS=800
DETECTOR_TEMPERATURE=0.2

# OLLAMA
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DETECTOR_MODEL=qwen3.5:4b
OLLAMA_THINK_MODE=off

# SIMULATOR
SIM_HEDGE_RATE=0.60
SIM_NORMALIZATION_RATE=0.40
SIM_CONTEXT_ANCHOR_RATE=0.55
SIM_DIRECT_ANSWER_RATE=0.82

# BENCHMARK
MIN_TURNS=20
MAX_TURNS=40
STOP_CONFIDENCE=0.66
CONF_SUPPORT_TAU=0.85
CONF_DEPTH_WEIGHT=0.80
CONF_UP_ALPHA=0.65
SUPERVISOR_EVIDENCE_MIN_SCORE=0.10
SUPERVISOR_EVIDENCE_RISK_THRESHOLD=0.10
SUPERVISOR_ESCAPE_EMPTY_STREAK=2
RISK_SENTINEL_FLAG_THRESHOLD=0.25
RISK_SENTINEL_SHORTCIRCUIT_THRESHOLD=1.1
