# AUTH
HF_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SEC=120
OPENROUTER_MAX_RETRIES=1
OPENROUTER_RETRY_BASE_MS=400
OPENROUTER_RETRY_JITTER_MS=250

# DETECTOR MODEL
AUTO_BACKEND_SWITCH=1
DETECTOR_BACKEND=local_hf
DETECTOR_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
OPENROUTER_DETECTOR_MODEL=meta-llama/llama-3-8b-instruct
DETECTOR_LOAD_IN_4BIT=1
DETECTOR_MAX_NEW_TOKENS=512
DETECTOR_TEMPERATURE=0.2
DETECTOR_TOP_P=0.9
DETECTOR_EXTRACTOR_MAX_NEW_TOKENS=800
DETECTOR_EXTRACTOR_TEMPERATURE=0.0
DETECTOR_EXTRACTOR_TOP_P=1.0

# Reasoning model budget — cap reasoning effort so content isn't starved.
# Valid values: low, medium, high (blank = provider default)
OPENROUTER_REASONING_EFFORT=low

# PERSONA BACKEND
# Fully deterministic (no API calls). "openrouter_sim" is a legacy name;
# the simulator uses seeded RNG + templates locally. No env var needed.

# LOCAL CUDA REQUIREMENT (used by AUTO_BACKEND_SWITCH)
MIN_CUDA_VRAM_GB=8
CALIBRATOR_MIN_TRAIN_RECORDS=10

# SYNTHETIC PERSONA + LEAKAGE CONTROLS
STRICT_SPLIT_LOCK=0
EVAL_STRATIFIED_STRICT=1
SIM_GENERATOR_VERSION=sim_v3
SIM_TEMPLATE_DISJOINT_ENFORCE=1
SIM_HEDGE_RATE=0.60
SIM_NORMALIZATION_RATE=0.40
SIM_CONTEXT_ANCHOR_RATE=0.55
SIM_DIRECT_ANSWER_RATE=0.82
SIM_DEPRESSED_TARGET_BDI=30
SIM_DEPRESSED_TARGET_JITTER=4
SIM_DEPRESSED_TARGET_BLEND=0.85

# STOP POLICY
MIN_TURNS=20
MAX_TURNS=40
STOP_CONFIDENCE=0.66
CONF_SUPPORT_TAU=1.25
CONF_DEPTH_WEIGHT=0.70
CONF_COVERAGE_WEIGHT=0.30
CONF_UP_ALPHA=0.55
CONF_DECAY_STREAK_START=6
CONF_DECAY_PER_TURN=0.002
CONF_DECAY_MAX=0.01
CONF_MAX_DROP_PER_TURN=0.01
FORCE_RISK_PROBE_TURN=4
FORCE_SOMATIC_PROBE_TURN=5
DETERMINISTIC_BDI_LABEL_THRESHOLD=14
DETERMINISTIC_CORE_ITEM_MEAN_THRESHOLD=0.6
DETERMINISTIC_CORE_ITEM_MIN_HITS=4
FINAL_CORE_ITEM_MIN_HITS=2
FINAL_CORE_SIGNAL_GATE=1.0
FINAL_OBS_BLEND_ENABLED=1
FINAL_OBS_BLEND_CONF_THRESHOLD=0.60
FINAL_OBS_BLEND_SUPPORT_MAX=2
FINAL_OBS_BLEND_MODULE_CONF_MIN=0.50
FINAL_OBS_BLEND_MAX_ALPHA=0.35
EVIDENCE_LLM_ON_LEXICAL_HIT=0
EXTRACTOR_JSON_KEY_ALIASES=1
EXTRACTOR_STRICT_SCHEMA_COERCE=1
EXTRACTOR_MIN_RECORDS_TARGET=1
EXTRACT_ITEM1_STRICT_GATE=1
EXTRACT_ITEM1_WEAK_MAX_CONF=0.55
EXTRACT_ITEM1_WEAK_MAX_INTENSITY=1.5
BELIEF_WEIGHT_LLM_EXTRACTOR=1.00
BELIEF_WEIGHT_LLM_SALVAGE=0.60
BELIEF_WEIGHT_LEXICAL_FALLBACK=0.45
BELIEF_WEIGHT_LEXICAL_PREFILTER=0.40
BELIEF_WEIGHT_DEFAULT=0.50
BELIEF_DUPLICATE_WEIGHT=0.15
BELIEF_DECAY_START_SUPPORT=2
BELIEF_DECAY_TAU=2.0
BELIEF_CONTRADICTION_WEIGHT=0.50
BELIEF_CONTRADICTION_NEUTRAL_BLEND=0.35
BELIEF_SUPPORT_MIN_WEIGHT=0.45
BELIEF_MEMORY_PER_ITEM=24
SUPERVISOR_EVIDENCE_MIN_SCORE=0.30
SUPERVISOR_EVIDENCE_RISK_THRESHOLD=0.22
SUPERVISOR_ESCAPE_EMPTY_STREAK=2
RISK_SENTINEL_FLAG_THRESHOLD=0.45
RISK_SENTINEL_SHORTCIRCUIT_THRESHOLD=1.1
RISK_SENTINEL_ACTIVE_SHORTCIRCUIT=0
