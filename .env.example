# AUTH
HF_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SEC=120

# DETECTOR MODEL
AUTO_BACKEND_SWITCH=1
DETECTOR_BACKEND=local_hf
DETECTOR_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
OPENROUTER_DETECTOR_MODEL=meta-llama/llama-3-8b-instruct
DETECTOR_LOAD_IN_4BIT=1
DETECTOR_MAX_NEW_TOKENS=96
DETECTOR_TEMPERATURE=0.2
DETECTOR_TOP_P=0.9

# PERSONA BACKEND
PERSONA_BACKEND=hf_adapter
ERISK_BASE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
ERISK_ADAPTER_ID=Anxo/erisk26-task1-patient-00-adapter
OPENROUTER_PERSONA_MODEL=meta-llama/llama-3-8b-instruct
ERISK_LOAD_IN_4BIT=1
ERISK_MAX_NEW_TOKENS=96
ERISK_TEMPERATURE=0.7
ERISK_TOP_P=0.9

# LOCAL CUDA REQUIREMENT (used by AUTO_BACKEND_SWITCH)
MIN_CUDA_VRAM_GB=8
CALIBRATOR_MIN_TRAIN_RECORDS=10

# SYNTHETIC PERSONA + LEAKAGE CONTROLS
STRICT_SPLIT_LOCK=0
SIM_GENERATOR_VERSION=sim_v2
SIM_PARAPHRASE_ENABLED=1
SIM_PARAPHRASE_RATE=0.5
SIM_TEMPLATE_DISJOINT_ENFORCE=1
SIM_HEDGE_RATE=0.65
SIM_NORMALIZATION_RATE=0.45
SIM_CONTEXT_ANCHOR_RATE=0.55
SIM_DIRECT_ANSWER_RATE=0.78

# STOP POLICY
MIN_TURNS=6
MAX_TURNS=10
STOP_CONFIDENCE=0.85
MIN_EVIDENCE_FOR_CONF_STOP=2
DETERMINISTIC_BDI_LABEL_THRESHOLD=14
DETERMINISTIC_CORE_ITEM_MEAN_THRESHOLD=0.6
DETERMINISTIC_CORE_ITEM_MIN_HITS=4
FINAL_CORE_ITEM_MIN_HITS=2
FINAL_CORE_SIGNAL_GATE=1.0
EVIDENCE_LLM_ON_LEXICAL_HIT=0
SUPERVISOR_EVIDENCE_MIN_SCORE=0.30
SUPERVISOR_EVIDENCE_RISK_THRESHOLD=0.22
SUPERVISOR_ESCAPE_EMPTY_STREAK=2
